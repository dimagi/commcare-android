{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/ktlint-check.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "connect-tech@dimagi-claude-workflows": true
  },
  "extraKnownMarketplaces": {
    "dimagi-claude-workflows": {
      "source": {
        "source": "github",
        "repo": "dimagi/dimagi-claude-workflows"
      }
    }
  }
}