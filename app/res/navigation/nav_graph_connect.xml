<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_connect"
   >

    <fragment
        android:id="@+id/connect_unlock_fragment"
        android:name="org.commcare.fragments.connect.ConnectUnlockFragment"
        android:label="fragment_connect_unlock"
        tools:layout="@layout/fragment_connect_unlock">
    </fragment>

    <fragment
        android:id="@+id/connect_jobs_list_fragment"
        android:name="org.commcare.fragments.connect.ConnectOpportunityListFragment"
        android:label="fragment_connect_jobs_list"
        tools:layout="@layout/fragment_connect_jobs_list">
        <action
            android:id="@+id/action_connect_jobs_list_fragment_to_opportunity_home_fragment"
            app:destination="@id/opportunity_home_fragment" />
    </fragment>

    <fragment
        android:id="@+id/opportunity_home_fragment"
        android:name="org.commcare.connect.opportunity.OpportunityHomeFragment"
        android:label="@string/connect_title"
        tools:layout="@layout/fragment_opportunity_home">
        <action
            android:id="@+id/action_opportunity_home_fragment_to_connect_delivery_visits_detail_fragment"
            app:destination="@id/connect_delivery_visits_detail_fragment" />
        <action
            android:id="@+id/action_opportunity_home_fragment_to_connect_learn_modules_bottom_sheet"
            app:destination="@id/connect_learn_modules_bottom_sheet" />
        <action
            android:id="@+id/action_opportunity_home_fragment_to_personalid_message_display_dialog"
            app:destination="@id/personalid_message_display_dialog" />
    </fragment>

    <fragment
        android:id="@+id/connect_delivery_visits_detail_fragment"
        android:name="org.commcare.fragments.connect.ConnectDeliveryVisitsDetailFragment"
        android:label="fragment_connect_delivery_visits_detail"
        tools:layout="@layout/fragment_connect_delivery_visits_detail">
        <argument
            android:name="unitId"
            app:argType="string" />
    </fragment>

    <dialog
        android:id="@+id/connect_learn_modules_bottom_sheet"
        android:name="org.commcare.fragments.connect.ConnectLearnModulesBottomSheet"
        tools:layout="@layout/fragment_connect_learn_modules_sheet"
        android:label="ConnectLearnModulesBottomSheet" />
    <dialog
        android:id="@+id/personalid_message_display_dialog"
        android:name="org.commcare.fragments.personalId.PersonalIdMessageFragment"
        android:label="fragment_personalid_message"
        tools:layout="@layout/screen_personalid_message">
        <argument
            android:name="title"
            app:argType="string" />
        <argument
            android:name="message"
            app:argType="string" />
        <argument
            android:name="callingClass"
            app:argType="integer"
            android:defaultValue="-1"/>
        <argument
            android:name="buttonText"
            app:nullable="false"
            app:argType="string" />
        <argument
            android:name="button2Text"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="isCancellable"
            android:defaultValue="true"
            app:argType="boolean" />
    </dialog>

</navigation>
