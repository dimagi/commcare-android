<resources>
    <declare-styleable name="AspectRatioLayout">
        <attr name="ratio_width" format="float" />
        <attr name="ratio_height" format="float" />
    </declare-styleable>
    <!--
        Connect colour roles, assigned in ConnectTheme. Named after their Material 3 counterparts so
        a later Material upgrade can collapse them into the real M3 roles by re-pointing this file.
        The roles Material 1.3.0 already provides (colorPrimary, colorOnPrimary, colorSurface,
        colorOnSurface, colorError) are not redeclared here.
        The on-surface roles run from strongest to weakest emphasis.
    -->
    <attr name="connectBackground" format="reference|color" />
    <attr name="connectSurfaceContainerLow" format="reference|color" />
    <attr name="connectOnSurfaceEmphasis" format="reference|color" />
    <attr name="connectOnSurfaceStrong" format="reference|color" />
    <attr name="connectOnSurfaceVariant" format="reference|color" />
    <attr name="connectOnSurfaceMuted" format="reference|color" />
    <attr name="connectPrimaryContainer" format="reference|color" />
    <attr name="connectOnPrimaryContainer" format="reference|color" />
    <attr name="connectInversePrimary" format="reference|color" />
    <attr name="connectStatusPositive" format="reference|color" />
    <attr name="connectStatusNegative" format="reference|color" />

    <attr name="detail_even_row_color" format="reference" />
    <attr name="detail_odd_row_color" format="reference" />
    <attr name="entity_view_header_background_color" format="reference" />
    <attr name="entity_view_header_text_color" format="reference" />
    <attr name="searchbox_action_bar_color" format="reference" />
    <attr name="drawer_pulldown_text_color" format="reference" />
    <attr name="drawer_pulldown_even_row_color" format="reference" />
    <attr name="drawer_pulldown_odd_row_color" format="reference" />
    <attr name="menu_tile_title_text_color" format="reference" />
    <attr name="entity_select_title_text_color" format="reference" />

    <declare-styleable name="ShrinkingLinearLayout">
        <attr name="shrinkable_view" format="reference" />
    </declare-styleable>

    <declare-styleable name="CustomButtonWithText">
        <attr name="backgroundColor" format="color"  />
        <attr name="subtitle" format="string" />
        <attr name="img" format="reference"  />
        <attr name="textColor" format="color" />
    </declare-styleable>

    <declare-styleable name="ResizingTextView">
        <attr name="text_size_small" format="reference|dimension" />
    </declare-styleable>

    <attr name="filter_select_background_color" format="reference" />
    <attr name="filter_select_text_color" format="reference" />

    <declare-styleable name="TabbedDetailView">
        <attr name="even_row_color" format="reference|color" />
        <attr name="odd_row_color" format="reference|color" />
    </declare-styleable>

    <declare-styleable name="ClippingView">
        <attr name="clip_start_x" format="reference|float" />
        <attr name="clip_start_y" format="reference|float" />
        <attr name="clip_width" format="reference|float" />
        <attr name="clip_height" format="reference|float" />
        <attr name="clip_corner_radius" format="dimension|reference"/>
    </declare-styleable>

    <declare-styleable name="FilePreference">
        <attr name="file_type" format="string" />
    </declare-styleable>
    <declare-styleable name="NumericCodeView">
        <attr name="codeViewDigitCount" format="integer" />
        <attr name="codeViewBorderColor" format="color" />
        <attr name="codeViewBorderRadius" format="dimension" />
        <attr name="codeViewBorderWidth" format="dimension" />
        <attr name="codeViewTextColor" format="color" />
        <attr name="codeViewTextSize" format="dimension" />
        <attr name="codeViewErrorBorderColor" format="color" />
        <attr name="codeViewErrorTextColor" format="color" />
        <attr name="codeViewPasswordMode" format="boolean" />
    </declare-styleable>
    <declare-styleable name="CustomEditText">
        <!-- Border attributes -->
        <attr name="editTextBorderWidth" format="dimension"/>
        <attr name="editTextCornerRadius" format="dimension"/>
        <attr name="editTextBorderColor" format="color"/>

        <!-- Editable attribute -->
        <attr name="editTextEditable" format="boolean"/>

        <!-- Drawable attributes -->
        <attr name="editTextDrawableStart" format="reference"/>
        <attr name="editTextDrawableEnd" format="reference"/>
        <attr name="editTextDrawableStartVisible" format="boolean"/>
        <attr name="editTextDrawableEndVisible" format="boolean"/>
        <attr name="editTextDrawableTint" format="color"/>

        <!-- Padding for drawables -->
        <attr name="editTextDrawableStartPaddingLeft" format="dimension"/>
        <attr name="editTextDrawableEndPaddingRight" format="dimension"/>
        <attr name="editTextDrawablePadding" format="dimension"/>

        <attr name="editTextText" format="string"/>
        <attr name="editTextHintColor" />
        <attr name="editTextTextSize" format="dimension"/>
        <attr name="editTextHint" format="string"/>
        <attr name="editTextHintSize" />

        <!-- New padding attributes -->
        <attr name="editTextPaddingTop" format="dimension" />
        <attr name="editTextPaddingBottom" format="dimension" />
        <attr name="editTextPaddingStart" format="dimension" />
        <attr name="editTextPaddingEnd" format="dimension" />
        <attr name="editTextFontFamily" format="string" />
    </declare-styleable>
    <attr name="editTextHintColor" format="color"/>
    <attr name="editTextHintSize" format="dimension"/>

    <declare-styleable name="PhoneInputView">
        <attr name="borderVisible" format="boolean" />
        <attr name="borderColor" format="color" />
        <attr name="borderRadius" format="dimension" />
        <attr name="countryCodeTextColor" format="color" />
        <attr name="countryCodeTextSize" format="dimension" />
        <attr name="editTextHintColor" />
        <attr name="editTextHintSize" />
        <attr name="editTextColor" format="color" />
        <attr name="editTextSize" format="dimension" />
        <attr name="dividerVisible" format="boolean" />
        <attr name="dividerColor" format="color" />
        <attr name="dividerWidth" format="dimension" />
        <attr name="dividerLeftPadding" format="dimension" />
        <attr name="dividerRightPadding" format="dimension" />
    </declare-styleable>
    <declare-styleable name="RoundedButton">
        <attr name="roundButtonHeight" format="dimension" />
        <attr name="roundButtonRadius" format="dimension" />
        <attr name="roundButtonBackgroundColor" format="color" />
        <attr name="roundButtonTextColor" format="color" />
        <attr name="roundButtonIconTintColor" format="color" />
        <attr name="roundButtonIcon" format="reference" />
        <attr name="roundButtonIconLeftAlign" format="boolean" />
        <attr name="roundButtonLeftPadding" format="dimension" />
        <attr name="roundButtonRightPadding" format="dimension" />
        <attr name="roundButtonFontFamily" format="reference" />
        <attr name="roundButtonBorderVisible" format="boolean" />
        <attr name="roundButtonBorderColor" format="color" />
        <attr name="roundButtonBorderRadius" format="dimension" />
        <attr name="roundButtonBorderWidth" format="dimension" />
        <attr name="roundButtonTextSize" format="dimension" />
        <attr name="roundButtonIconPadding" format="dimension"/>
    </declare-styleable>

    <declare-styleable name="FaceCaptureView">
        <attr name="background_color" format="color" />
        <attr name="face_capture_area_delimiter_color" format="color" />
        <attr name="face_marker_color" format="color" />
        <attr name="countdown_text_size" format="dimension" />
    </declare-styleable>

    <declare-styleable name="CircleProgressBar">
        <attr name="progressColor" format="color" />
        <attr name="progressBackgroundColor" format="color" />
        <attr name="strokeWidth" format="dimension" />
    </declare-styleable>

    <declare-styleable name="SemiCircleProgressBar">
        <attr name="progressColor" />
        <attr name="trackColor" format="color" />
        <attr name="valueTextColor" format="color" />
        <attr name="descriptionTextColor" format="color" />
        <attr name="strokeWidth" />
        <attr name="valueTextSize" format="dimension" />
        <attr name="descriptionTextSize" format="dimension" />
        <attr name="currentValue" format="integer" />
        <attr name="maxValue" format="integer" />
        <attr name="descriptionText" format="string" />
    </declare-styleable>

    <declare-styleable name="ConnectInfoHalfCard">
        <attr name="valueText" format="string" />
        <attr name="titleText" format="string" />
        <attr name="subtitleText" format="string" />
        <attr name="icon" format="reference" />
        <attr name="navigable" format="boolean" />
        <attr name="contentEnabled" />
    </declare-styleable>

    <declare-styleable name="ConnectInfoCard">
        <attr name="valueText" />
        <attr name="titleText" />
        <attr name="subtitleText" />
        <attr name="navigable" />
    </declare-styleable>

    <declare-styleable name="ConnectSyncStatusCard">
        <attr name="statusText" format="string" />
        <attr name="statusSubtext" format="string" />
        <attr name="warning" format="boolean" />
        <attr name="syncOkBadgeColor" format="color" />
        <attr name="syncOkIconColor" format="color" />
        <attr name="syncOkStrokeColor" format="color" />
        <attr name="syncWarningBadgeColor" format="color" />
        <attr name="syncWarningIconColor" format="color" />
        <attr name="syncWarningStrokeColor" format="color" />
        <attr name="syncOkIcon" format="reference" />
        <attr name="syncWarningIcon" format="reference" />
    </declare-styleable>

    <declare-styleable name="ConnectSuccessFailureCard">
        <attr name="mode" format="enum">
            <enum name="success" value="0" />
            <enum name="failure" value="1" />
        </attr>
        <attr name="messageText" format="string" />
        <attr name="cardCornerRadius" />
        <attr name="cardElevation" />
        <attr name="successBackgroundColor" format="color" />
        <attr name="successAccentColor" format="color" />
        <attr name="failureBackgroundColor" format="color" />
        <attr name="failureAccentColor" format="color" />
    </declare-styleable>

    <declare-styleable name="ConnectCtaBar">
        <attr name="titleText" />
        <attr name="subtitleText" />
        <attr name="buttonText" format="string" />
        <attr name="infoMessage" format="string" />
        <attr name="progress" format="integer" />
    </declare-styleable>

    <declare-styleable name="ConnectProgressCard">
        <attr name="titleText" />
        <attr name="semiCircleVisible" format="boolean" />
        <attr name="semiCircleCurrent" format="integer" />
        <attr name="semiCircleMax" format="integer" />
        <attr name="semiCircleDescription" format="string" />
        <attr name="linearProgressLabel" format="string" />
        <attr name="linearProgressCurrent" format="integer" />
        <attr name="linearProgressMax" format="integer" />
        <attr name="linearProgressCaption" format="string" />
        <attr name="contentEnabled" format="boolean" />
        <attr name="infoMessage" />
        <attr name="infoCtaText" format="string" />
        <attr name="contentPrimaryColor" format="color" />
        <attr name="contentAccentColor" format="color" />
        <attr name="contentDisabledColor" format="color" />
    </declare-styleable>

    <declare-styleable name="RectangleOverlayView">
        <attr name="reticleScrimColor" format="color" />
        <attr name="reticleStrokeColor" format="color" />
        <attr name="reticleOutlineColor" format="color" />
        <attr name="reticleStrokeWidth" format="dimension" />
        <attr name="reticleOutlineWidth" format="dimension" />
        <attr name="reticleWidthFractionPortrait" format="float" />
        <attr name="reticleHeightFractionPortrait" format="float" />
        <attr name="reticleWidthFractionLandscape" format="float" />
        <attr name="reticleHeightFractionLandscape" format="float" />
    </declare-styleable>
</resources>
