<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_dialog_bg"
    android:orientation="vertical"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/circle_info_bg"
            android:gravity="center">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_key_round"
                app:tint="@color/connect_blue_color" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/reminder_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/personalid_backup_code_reminder_title"
                android:textColor="@color/connect_dark_blue_color"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/personalid_backup_code_reminder_message"
                android:textColor="@color/connect_subtext"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/lock_icon_container"
            android:layout_width="46dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/connect_side_icon_bg"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_outline_lock_24"
                app:tint="@color/connect_dark_blue_color" />
        </LinearLayout>

        <org.commcare.views.connect.NumericCodeView
            android:id="@+id/backup_code_view"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            app:codeViewBorderColor="@color/connect_blue_color"
            app:codeViewBorderRadius="8dp"
            app:codeViewBorderWidth="1.4dp"
            app:codeViewDigitCount="6"
            app:codeViewErrorBorderColor="@color/connect_red"
            app:codeViewErrorTextColor="@color/connect_red"
            app:codeViewPasswordMode="true"
            app:codeViewTextColor="@color/connect_blue_color"
            app:codeViewTextSize="6sp" />

        <ImageView
            android:id="@+id/backup_code_visibility_toggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_visibility_24"
            app:tint="@color/connect_blue_color" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/error_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/error_banner_bg"
        android:gravity="top"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="1dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_alert_circle_24"
            app:tint="@color/connect_red" />

        <TextView
            android:id="@+id/error_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/connect_red"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/forgot_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/personalid_forgot_backup_code"
        android:textColor="@color/cc_brand_color"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/skip_button"
            style="@style/NegativeButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:text="@string/personalid_backup_code_reminder_skip" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirm_button"
            style="@style/CustomButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:enabled="false"
            android:text="@string/personalid_backup_code_reminder_confirm" />
    </LinearLayout>

</LinearLayout>
