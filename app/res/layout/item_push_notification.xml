<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:theme="@style/ConnectTheme">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivNotification"
        android:layout_width="@dimen/connect_notification_icon_size"
        android:layout_height="@dimen/connect_notification_icon_size"
        android:layout_marginStart="@dimen/standard_spacer_double"
        android:layout_marginTop="@dimen/standard_spacer_double"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_chat_bubble_outline" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvNotification"
        style="@style/TextStyle.Connect.BodyM"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/standard_spacer_one_and_half"
        android:layout_marginEnd="@dimen/standard_spacer_double"
        android:textColor="?attr/connectOnSurfaceEmphasis"
        app:layout_constraintBottom_toBottomOf="@id/ivNotification"
        app:layout_constraintEnd_toStartOf="@id/ivForwardArrow"
        app:layout_constraintStart_toEndOf="@id/ivNotification"
        app:layout_constraintTop_toTopOf="@id/ivNotification"
        tools:text="You received 4 new messages. Click here to view it." />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivForwardArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/standard_spacer_double"
        android:src="@drawable/ic_connect_arrow_forward"
        app:layout_constraintBottom_toBottomOf="@id/tvNotification"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvNotification" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTime"
        style="@style/Widget.Connect.HelperText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/standard_spacer_double"
        android:gravity="end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNotification" />

    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/connect_stroke_hairline"
        android:layout_marginTop="@dimen/standard_spacer_half"
        android:background="?attr/connectOutlineVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTime" />

</androidx.constraintlayout.widget.ConstraintLayout>