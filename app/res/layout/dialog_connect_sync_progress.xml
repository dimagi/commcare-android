<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_dialog_bg"
    android:padding="@dimen/connect_space_xl"
    tools:theme="@style/ConnectTheme">

    <TextView
        android:id="@+id/dialog_title_text"
        style="@style/TextStyle.Connect.TitleM"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/connect_sync_dialog_in_progress_title" />

    <TextView
        android:id="@+id/progress_dialog_message"
        style="@style/TextStyle.Connect.BodyS"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/connect_space_md"
        android:layout_marginEnd="@dimen/connect_space_sm"
        android:textColor="?attr/connectOnSurfaceVariant"
        app:layout_constraintEnd_toStartOf="@id/sync_progress_percent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_title_text"
        tools:text="1 of 4 forms synced" />

    <TextView
        android:id="@+id/sync_progress_percent"
        style="@style/TextStyle.Connect.TitleS"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone"
        app:layout_constraintBaseline_toBaselineOf="@id/progress_dialog_message"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="24%"
        tools:visibility="visible" />

    <ProgressBar
        android:id="@+id/progress_bar_horizontal"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="@dimen/connect_space_xs"
        android:layout_marginTop="@dimen/connect_space_sm"
        android:progressDrawable="@drawable/connect_sync_progress_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_dialog_message"
        tools:progress="24" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sync_progress_dismiss"
        style="@style/Widget.Connect.CtaBarButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/connect_space_lg"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="@dimen/connect_space_lg"
        android:paddingTop="@dimen/connect_space_sm"
        android:paddingBottom="@dimen/connect_space_sm"
        android:text="@string/connect_sync_dialog_dismiss"
        app:cornerRadius="@dimen/connect_radius_pill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_bar_horizontal" />
</androidx.constraintlayout.widget.ConstraintLayout>
