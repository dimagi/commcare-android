<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="?attr/colorSurface"
            android:orientation="vertical"
            android:padding="@dimen/connect_space_lg">

            <TextView
                android:id="@+id/connect_message_title"
                style="@style/Widget.Connect.HeadingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/connect_space_sm" />

            <TextView
                android:id="@+id/connect_message_message"
                style="@style/Widget.Connect.BodyText"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/connect_space_sm"
                android:layout_marginBottom="@dimen/connect_space_xl"
                android:gravity="start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connect_message_button"
                style="@style/ConnectPrimaryButtonStyle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/content_start"
                android:paddingBottom="@dimen/content_start"
                android:text="@string/back" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connect_message_button2"
                style="@style/ConnectPrimaryButtonStyle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/connect_space_lg"
                android:layout_marginBottom="@dimen/connect_space_lg"
                android:paddingTop="@dimen/content_start"
                android:paddingBottom="@dimen/content_start"
                android:visibility="gone"
                />

        </LinearLayout>
    </FrameLayout>
</layout>