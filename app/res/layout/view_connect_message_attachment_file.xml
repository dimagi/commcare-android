<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/connect_touch_target_min"
    android:orientation="horizontal">

    <ImageView
        style="@style/ConnectMessageAttachmentActionCircle"
        android:layout_width="@dimen/connect_icon_circle_lg"
        android:layout_height="@dimen/connect_icon_circle_lg"
        android:contentDescription="@null"
        android:src="@drawable/ic_connect_message_file" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/connect_space_md"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="@dimen/connect_text_body"
            tools:text="instructions.pdf" />

        <TextView
            android:id="@+id/tvFileSize"
            style="@style/ConnectMessageAttachmentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="403 kB" />
    </LinearLayout>
</LinearLayout>
