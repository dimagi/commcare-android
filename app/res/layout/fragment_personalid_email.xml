<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/personalid_email_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/TextStyle.PersonalId.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/connect_space_lg"
            android:layout_marginTop="@dimen/connect_space_xl"
            android:layout_marginEnd="@dimen/connect_space_lg"
            android:text="@string/personalid_email_title" />

        <TextView
            style="@style/TextStyle.PersonalId.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/connect_space_lg"
            android:layout_marginTop="@dimen/connect_space_sm"
            android:layout_marginEnd="@dimen/connect_space_lg"
            android:text="@string/personalid_email_description" />

        <LinearLayout
            android:id="@+id/email_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/connect_space_lg"
            android:layout_marginTop="@dimen/connect_space_xl"
            android:layout_marginEnd="@dimen/connect_space_lg"
            android:gravity="start"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/connect_side_icon_bg"
                android:padding="1dp"
                android:scaleType="center"
                android:src="@drawable/ic_outline_email_24" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/email_text_value"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginStart="@dimen/connect_space_lg"
                android:background="@drawable/connect_edit_text_bg"
                android:hint="@string/personalid_email_hint"
                android:imeOptions="actionDone"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingStart="@dimen/connect_space_lg"
                android:textColorHint="@color/connect_grey" />

        </LinearLayout>

        <TextView
            android:id="@+id/personalid_email_error"
            style="@style/TextStyle.PersonalId.Error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="84dp"
            android:paddingTop="@dimen/connect_space_xs"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/connect_space_md"
            android:layout_marginTop="@dimen/connect_space_xl"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/personalid_email_skip_button"
                style="@style/CustomSecondaryCtaButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/personalid_email_skip" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/personalid_email_continue_button"
                style="@style/PersonalIdPrimaryButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacer_small"
                android:layout_weight="1"
                android:drawableEnd="@drawable/connect_right_arrow"
                android:enabled="false"
                android:gravity="center"
                android:text="@string/personalid_continue_label" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
