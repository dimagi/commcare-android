<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/connectSurfaceContainerLow"
    android:scrollbars="none"
    tools:viewBindingIgnore="true">

    <LinearLayout
        android:id="@+id/screen_first_start_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/grid_header_top_banner"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="@dimen/standard_spacer_double"
            android:paddingStart="@dimen/standard_spacer_double"
            android:paddingTop="@dimen/standard_spacer_large">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:contentPaddingBottom="40dp"
                app:contentPaddingLeft="@dimen/standard_spacer_large"
                app:contentPaddingRight="@dimen/standard_spacer_large"
                app:contentPaddingTop="40dp"
                app:strokeColor="?attr/connectOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/screen_first_start_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/str_setup_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="6sp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_headline" />

                    <TextView
                        android:id="@+id/str_setup_message_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/standard_spacer"
                        android:gravity="center"
                        android:lineSpacingExtra="4sp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_small" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start_install"
                        style="@style/Widget.CommCare.Button.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp48"
                        android:layout_marginTop="@dimen/standard_spacer_extra_large" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_stop_install"
                        style="@style/Widget.CommCare.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp48"
                        android:layout_marginTop="@dimen/standard_spacer_double" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/net_warn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/standard_spacer_large"
                android:drawablePadding="@dimen/standard_spacer_one_and_half"
                android:gravity="center_vertical"
                android:lineSpacingExtra="4sp"
                android:textColor="?attr/connectOnSurfaceSecondary"
                android:textSize="@dimen/text_caption"
                app:drawableStartCompat="@drawable/icon_wifi_neutral"
                app:drawableTint="?attr/connectOnSurfaceSecondary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
