<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context="org.commcare.fragments.connectMessaging.ConnectMessagingSettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/connect_space_lg">

        <TextView
            android:id="@+id/tvAutoDownloadTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/connect_messaging_settings_auto_download_title"
            android:textColor="@color/black"
            android:textSize="@dimen/connect_text_title" />

        <RadioGroup
            android:id="@+id/rgAutoDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/connect_space_sm">

            <RadioButton
                android:id="@+id/rbAnyNetwork"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/connect_touch_target_min"
                android:text="@string/connect_messaging_settings_any_network"
                android:textColor="@color/black"
                android:textSize="@dimen/connect_text_body" />

            <RadioButton
                android:id="@+id/rbLargeOnWifiOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/connect_touch_target_min"
                android:text="@string/connect_messaging_settings_large_on_wifi_only"
                android:textColor="@color/black"
                android:textSize="@dimen/connect_text_body" />

            <RadioButton
                android:id="@+id/rbManualOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/connect_touch_target_min"
                android:text="@string/connect_messaging_settings_manual_only"
                android:textColor="@color/black"
                android:textSize="@dimen/connect_text_body" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/connect_space_sm"
            android:text="@string/connect_messaging_settings_tap_note"
            android:textColor="@color/sonic_silver"
            android:textSize="@dimen/connect_text_caption" />
    </LinearLayout>
</ScrollView>
