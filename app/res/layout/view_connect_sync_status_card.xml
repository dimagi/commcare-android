<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/connect_space_lg"
    tools:theme="@style/ConnectTheme">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/connect_space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sync_card_text"
            style="@style/TextStyle.Connect.LabelM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            tools:text="Everything is synced" />

        <TextView
            android:id="@+id/sync_card_subtext"
            style="@style/TextStyle.Connect.LabelS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/connect_sync_card_subtext_spacing"
            android:textColor="?attr/connectOutline"
            android:visibility="gone"
            tools:text="Synced just now"
            tools:visibility="visible" />

    </LinearLayout>

    <ImageView
        android:id="@+id/sync_card_icon"
        android:layout_width="@dimen/connect_sync_card_badge_size"
        android:layout_height="@dimen/connect_sync_card_badge_size"
        android:background="@drawable/bg_connect_circle"
        android:contentDescription="@null"
        android:padding="@dimen/connect_sync_card_badge_icon_inset"
        tools:backgroundTint="?attr/connectStatusPositiveContainer"
        tools:src="@drawable/check_update"
        tools:tint="?attr/connectStatusPositive" />

</LinearLayout>
