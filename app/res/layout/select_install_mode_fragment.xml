<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:SquareButtonWithText="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_first_start_main"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/cool_gray_50"
    android:orientation="vertical"
    tools:viewBindingIgnore="true">

    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/cool_gray_50"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/grid_header_top_banner"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingEnd="@dimen/standard_spacer_double"
                android:paddingStart="@dimen/standard_spacer_double"
                android:paddingTop="@dimen/standard_spacer_large">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/connect_login_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp48"
                    android:fontFamily="sans-serif-medium"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/connect_button_logged_in"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_small"
                    android:visibility="gone"
                    app:backgroundTint="@color/neon_blue"
                    app:cornerRadius="4dp"
                    app:elevation="0dp" />

                <include
                    android:id="@+id/login_or"
                    layout="@layout/or_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/standard_spacer_double"
                    android:layout_marginTop="@dimen/standard_spacer_double"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/mist_gray"
                    app:strokeWidth="1dp"
                    app:contentPaddingBottom="40dp"
                    app:contentPaddingLeft="@dimen/standard_spacer_large"
                    app:contentPaddingRight="@dimen/standard_spacer_large"
                    app:contentPaddingTop="40dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/str_setup_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:lineSpacingExtra="6sp"
                            android:textColor="@color/dark_slate"
                            android:textSize="@dimen/text_headline" />

                        <TextView
                            android:id="@+id/str_setup_message_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/standard_spacer"
                            android:gravity="center"
                            android:lineSpacingExtra="4sp"
                            android:textColor="@color/dark_slate"
                            android:textSize="@dimen/text_small" />

                        <LinearLayout
                            android:id="@+id/screen_first_start_bottom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/standard_spacer_extra_large"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/btn_fetch_uri"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="84dp"
                                    android:layout_height="84dp"
                                    android:background="@drawable/install_option_tile_background"
                                    android:importantForAccessibility="no"
                                    android:padding="@dimen/standard_spacer_double"
                                    app:srcCompat="@drawable/ic_qr_code_2" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:gravity="center"
                                    android:lineSpacingExtra="4sp"
                                    android:text="@string/install_via_qr_code"
                                    android:textColor="@color/dark_slate"
                                    android:textSize="@dimen/text_caption" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/enter_app_location"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="84dp"
                                    android:layout_height="84dp"
                                    android:background="@drawable/install_option_tile_background"
                                    android:importantForAccessibility="no"
                                    android:padding="@dimen/standard_spacer_double"
                                    app:srcCompat="@drawable/ic_link_2" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:gravity="center"
                                    android:lineSpacingExtra="4sp"
                                    android:text="@string/install_via_app_code"
                                    android:textColor="@color/dark_slate"
                                    android:textSize="@dimen/text_caption" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btn_fetch_hub"
                            android:layout_width="109dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/standard_spacer_large"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="84dp"
                                android:layout_height="84dp"
                                android:background="@drawable/install_option_tile_background"
                                android:importantForAccessibility="no"
                                android:padding="@dimen/standard_spacer_double"
                                app:srcCompat="@drawable/startup_micronode"
                                app:tint="@color/deep_indigo" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:gravity="center"
                                android:lineSpacingExtra="4sp"
                                android:text="@string/install_from_local"
                                android:textColor="@color/dark_slate"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_margin="@dimen/standard_spacer_double"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/install_error_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/red_600"
                    android:textSize="@dimen/text_small"
                    android:visibility="gone"/>


                <FrameLayout
                    android:id="@+id/btn_view_errors_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/standard_spacer"
                    android:background="@drawable/tile_drop_shadow_small_margins">

                    <org.commcare.views.RectangleButtonWithText
                        android:id="@+id/btn_view_errors"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/rectangle_button_height"
                        SquareButtonWithText:backgroundColor="@color/cc_attention_negative_bg"
                        SquareButtonWithText:img="@drawable/ic_list_error"
                        SquareButtonWithText:subtitle="See Error Details"
                        SquareButtonWithText:textColor="@color/cc_attention_negative_text"/>

                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
