<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout"
    tools:theme="@style/ConnectTheme">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/connect_space_lg">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/learn_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/connect_space_lg"
                android:background="?attr/colorSurface"
                android:padding="@dimen/connect_space_lg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/learn_complete_icon"
                    android:layout_width="@dimen/standard_spacer_large"
                    android:layout_height="@dimen/standard_spacer_large"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_connect_learn_app"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/learn_complete_title"
                    style="@style/TextStyle.Connect.TitleM"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/connect_space_xs"
                    android:layout_marginEnd="@dimen/connect_space_xs"
                    android:text="@string/connect_opportunity_learn_section_title"
                    android:textColor="?attr/colorPrimary"
                    app:layout_constraintEnd_toStartOf="@id/learn_complete_check"
                    app:layout_constraintStart_toEndOf="@id/learn_complete_icon"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/learn_complete_completed_on"
                    style="@style/TextStyle.Connect.BodyS"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/connect_space_xs"
                    android:textColor="?attr/connectOnSurfaceVariant"
                    app:layout_constraintEnd_toEndOf="@id/learn_complete_title"
                    app:layout_constraintStart_toStartOf="@id/learn_complete_title"
                    app:layout_constraintTop_toBottomOf="@id/learn_complete_title"
                    tools:text="Completed on 21/12/2026" />

                <ImageView
                    android:id="@+id/learn_complete_check"
                    android:layout_width="@dimen/standard_spacer_large"
                    android:layout_height="@dimen/standard_spacer_large"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_connect_delivery_check_circle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/connectStatusPositive" />

                <LinearLayout
                    android:id="@+id/certificate_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/connect_space_lg"
                    android:background="@drawable/connect_view_info_card_border"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/connect_space_lg"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/learn_complete_completed_on">

                    <LinearLayout
                        android:id="@+id/certificate_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/connect_space_md">

                        <TextView
                            style="@style/TextStyle.Connect.LabelM"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/connect_learn_certificate"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView
                            android:id="@+id/certificate_chevron"
                            android:layout_width="@dimen/standard_spacer_large"
                            android:layout_height="@dimen/standard_spacer_large"
                            android:contentDescription="@null"
                            android:rotation="180"
                            android:src="@drawable/nav_drawer_arrow_down"
                            app:tint="?attr/connectOnSurfaceVariant" />
                    </LinearLayout>

                    <include
                        android:id="@+id/certificate"
                        layout="@layout/view_connect_learn_certificate" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView
                android:id="@+id/delivery_icon"
                android:layout_width="@dimen/standard_spacer_large"
                android:layout_height="@dimen/standard_spacer_large"
                android:layout_marginStart="@dimen/connect_space_lg"
                android:contentDescription="@null"
                android:layout_marginTop="1dp"
                android:src="@drawable/ic_connect_delivery_app"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/delivery_title" />

            <TextView
                android:id="@+id/delivery_title"
                style="@style/TextStyle.Connect.TitleM"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/connect_space_sm"
                android:layout_marginEnd="@dimen/connect_space_lg"
                android:text="@string/connect_opportunity_delivery_section_title"
                android:textColor="?attr/colorPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/connect_space_lg"
                app:layout_constraintStart_toEndOf="@id/delivery_icon"
                app:layout_constraintTop_toBottomOf="@id/learn_card" />

            <TextView
                android:id="@+id/delivery_subtitle"
                style="@style/TextStyle.Connect.BodyS"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/connect_space_xs"
                android:text="@string/connect_opportunity_delivery_section_subtitle"
                android:textColor="?attr/connectOnSurfaceVariant"
                app:layout_constraintEnd_toEndOf="@id/delivery_title"
                app:layout_constraintStart_toStartOf="@id/delivery_title"
                app:layout_constraintTop_toBottomOf="@id/delivery_title" />

            <org.commcare.views.connect.ConnectInfoCard
                android:id="@+id/card_total_visits"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/connect_space_lg"
                android:layout_marginTop="@dimen/connect_space_md"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/delivery_subtitle"
                app:titleText="@string/connect_opportunity_max_visits_label" />

            <org.commcare.views.connect.ConnectInfoCard
                android:id="@+id/card_days_to_complete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/connect_space_lg"
                android:layout_marginTop="@dimen/connect_space_md"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_total_visits"
                app:titleText="@string/connect_opportunity_days_to_complete_label" />

            <org.commcare.views.connect.ConnectInfoCard
                android:id="@+id/card_max_earnings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/connect_space_lg"
                android:layout_marginTop="@dimen/connect_space_md"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_days_to_complete"
                app:titleText="@string/connect_opportunity_max_earnings_card_label" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <org.commcare.views.connect.ConnectSuccessFailureCard
        android:id="@+id/learn_complete_failure_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/connect_space_lg"
        android:layout_marginBottom="@dimen/connect_space_lg" />

    <org.commcare.views.connect.ConnectCtaBar
        android:id="@+id/learn_complete_cta_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleText="@string/connect_learn_complete_footer_start_visits" />
</merge>
