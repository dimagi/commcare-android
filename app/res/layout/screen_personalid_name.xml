<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

        <ScrollView
            android:id="@+id/firstLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            app:layout_constraintTop_toTopOf="parent"
            android:orientation="vertical"
            tools:context="org.commcare.fragments.personalId.PersonalIdNameFragment">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name_fragment_title"
                    style="@style/Widget.Connect.HeadingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/connect_space_lg"
                    android:layout_marginTop="@dimen/connect_space_xl"
                    android:layout_marginEnd="@dimen/connect_space_lg"
                    android:text="@string/personalid_name_fragment_title" />

                <TextView
                    android:id="@+id/name_fragment_subtitle"
                    style="@style/Widget.Connect.BodyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/connect_space_lg"
                    android:layout_marginTop="@dimen/connect_space_sm"
                    android:layout_marginEnd="@dimen/connect_space_lg"
                    android:text="@string/personalid_name_fragment_subtitle" />

                <LinearLayout
                    android:id="@+id/name_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/connect_space_lg"
                    android:layout_marginTop="@dimen/connect_space_xl"
                    android:layout_marginEnd="@dimen/connect_space_lg"
                    android:gravity="start"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/connect_side_icon_bg"
                        android:gravity="center"
                        android:layout_gravity="center">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:padding="1dp"
                            android:scaleType="center"
                            android:src="@drawable/ic_outline_person_24" />

                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nameTextValue"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginStart="@dimen/connect_space_lg"
                        android:background="@drawable/connect_edit_text_bg"
                        android:hint="@string/connect_register_name"
                        android:inputType="textPersonName|textCapWords"
                        android:imeOptions="actionNext"
                        android:paddingStart="@dimen/connect_space_lg"
                        android:textColorHint="@color/connect_grey"
                        />

                </LinearLayout>

                <TextView
                    android:id="@+id/personalid_name_error"
                    style="@style/Widget.Connect.ErrorText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="84dp"
                    android:paddingTop="@dimen/connect_space_xs"
                    android:visibility="gone"
                     />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/personalid_name_continue_button"
                    style="@style/ConnectPrimaryButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/connect_space_lg"
                    android:layout_marginEnd="@dimen/connect_space_lg"
                    android:gravity="start|center"
                    android:text="@string/personalid_continue_label"
                    android:drawableEnd="@drawable/connect_right_arrow"
                    />

            </LinearLayout>
        </ScrollView>
</layout>
