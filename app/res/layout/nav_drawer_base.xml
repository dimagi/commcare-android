<LinearLayout android:layout_width="@dimen/nav_drawer_width"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:theme="@style/ConnectTheme"
    android:layout_gravity="start"
    android:paddingHorizontal="@dimen/side_nav_horizontal_padding"
    xmlns:android="http://schemas.android.com/apk/res/android">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="?attr/colorPrimary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/nav_drawer_header"
                    layout="@layout/nav_drawer_header"/>

                <LinearLayout
                    android:id="@+id/signout_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/side_nav_sign_out_top_margin"
                    android:visibility="gone"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/nav_drawer_signed_out_avatar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_personalid_avatar_placeholder"/>

                    <TextView
                        android:id="@+id/nav_drawer_signed_out_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:paddingVertical="@dimen/connect_space_lg"
                        android:clickable="true"
                        style="@style/TextStyle.Connect.BodyM"
                        android:textColor="?attr/colorOnPrimary"
                        android:text="@string/nav_drawer_not_signed_in_to_personal_id"/>

                    <FrameLayout
                        android:id="@+id/nav_drawer_error_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/connect_space_lg"
                        android:layout_marginTop="@dimen/connect_space_lg"
                        android:visibility="gone">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="?attr/connectStatusNegative"
                            app:cardCornerRadius="@dimen/connect_radius_lg"
                            app:cardElevation="@dimen/connect_info_card_elevation" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/connect_space_xs"
                            app:cardBackgroundColor="?attr/connectBrandMedium"
                            app:cardCornerRadius="@dimen/connect_radius_lg"
                            app:cardElevation="@dimen/connect_info_card_elevation">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center_horizontal"
                                android:padding="@dimen/connect_space_lg">

                                <TextView
                                    android:id="@+id/nav_drawer_error_title"
                                    style="@style/TextStyle.Connect.TitleM"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAlignment="center"
                                    android:textColor="?attr/colorOnPrimary" />

                                <TextView
                                    android:id="@+id/nav_drawer_error_message"
                                    style="@style/TextStyle.Connect.BodyM"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/connect_space_sm"
                                    android:textAlignment="center"
                                    android:textColor="?attr/colorOnPrimary" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/nav_drawer_reconfigure_button"
                                    style="@style/Widget.Connect.NavDrawerButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/connect_space_md"
                                    android:text="@string/personalid_reconfigure"
                                    app:backgroundTint="?attr/colorPrimary" />

                                <TextView
                                    android:id="@+id/nav_drawer_dismiss_link"
                                    style="@style/TextStyle.Connect.LabelM"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="@dimen/connect_space_md"
                                    android:background="?attr/selectableItemBackground"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:text="@string/personalid_dismiss"
                                    android:textColor="?attr/colorOnPrimary" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nav_drawer_sign_in_button"
                        style="@style/Widget.Connect.NavDrawerButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/nav_drawer_signin_register" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/nav_drawer_recycler"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:background="?attr/colorPrimary" />

                <include
                    android:id="@+id/nav_drawer_footer"
                    layout="@layout/nav_drawer_footer" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
