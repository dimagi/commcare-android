<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/personalid_email_verification_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/TextStyle.PersonalId.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/connect_space_lg"
            android:layout_marginTop="@dimen/connect_space_xl"
            android:layout_marginEnd="@dimen/connect_space_lg"
            android:text="@string/personalid_email_verification_title" />

        <TextView
            android:id="@+id/email_verification_description"
            style="@style/TextStyle.PersonalId.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/connect_space_lg"
            android:layout_marginTop="@dimen/connect_space_sm"
            android:layout_marginEnd="@dimen/connect_space_lg"
            tools:text="Enter the 6-digit code sent to user@example.com" />

        <LinearLayout
            android:id="@+id/otp_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/connect_space_lg"
            android:layout_marginTop="@dimen/connect_space_xl"
            android:layout_marginEnd="@dimen/connect_space_lg"
            android:gravity="start"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/connect_side_icon_bg"
                android:contentDescription="@null"
                android:padding="1dp"
                android:scaleType="center"
                android:src="@drawable/ic_outline_lock_24" />

            <org.commcare.views.connect.NumericCodeView
                android:id="@+id/otp_code_view"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginStart="@dimen/connect_space_lg"
                app:codeViewBorderColor="@color/connect_blue_color"
                app:codeViewBorderRadius="4dp"
                app:codeViewBorderWidth="0.5dp"
                app:codeViewDigitCount="6"
                app:codeViewErrorBorderColor="@color/connect_red"
                app:codeViewErrorTextColor="@color/connect_red"
                app:codeViewTextColor="@color/connect_blue_color"
                app:codeViewTextSize="6sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/personalid_email_verify_error"
            style="@style/TextStyle.PersonalId.Error"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/connect_space_lg"
            android:layout_marginTop="@dimen/connect_space_xs"
            android:gravity="start"
            android:visibility="gone" />

        <TextView
            android:id="@+id/personalid_resend_countdown_text"
            style="@style/TextStyle.PersonalId.Helper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="80dp"
            android:layout_marginTop="@dimen/connect_space_xs"
            tools:text="Resend OTP in 60s" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/connect_space_lg"
            android:layout_marginTop="@dimen/connect_space_lg"
            android:layout_marginEnd="@dimen/connect_space_lg"
            android:layout_marginBottom="@dimen/connect_space_lg"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/personalid_email_resend_button"
                style="@style/NegativeButtonStyle"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="@string/connect_verify_phone_resend_code"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/personalid_email_verify_button"
                style="@style/ConnectPrimaryButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:enabled="false"
                android:text="@string/connect_verify_phone_verify" />

        </RelativeLayout>

    </LinearLayout>
</ScrollView>
